# Данные для интеграции с  NC.
NEXTCLOUD_URL=
NEXTCLOUD_API_USER=
NEXTCLOUD_API_PASSWORD=

# Сервер приложения.
APP_HOST=
APP_PORT=

# MongoDB.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGODB_CONNECTION=

# Управление MongoDB через MongoExpress.
ME_CONFIG_BASICAUTH_USERNAME=
ME_CONFIG_BASICAUTH_PASSWORD=

# DocumentBot — мониторинг папки Nextcloud и обработка документов через llama.cpp
DOCUMENT_WATCH_DIR=incoming-docs/
LLAMA_SERVER_URL=http://localhost:8080
DOCUMENT_CHAT_ROOM=
POLL_INTERVAL_SEC=60

# PostgreSQL (DocumentBot — база данных документов, compose-postgres.yaml)
POSTGRES_DB=documents
POSTGRES_USER=documents
POSTGRES_PASSWORD=documents
POSTGRES_DSN=postgresql://documents:documents@localhost:5433/documents
